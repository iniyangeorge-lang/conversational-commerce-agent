{
  "name": "conversational-commerce-agent",
  "private": true,
  "version": "0.0.0",
  "description": "Conversational Commerce Agent - Visa Challenge (monorepo)",
  "workspaces": [
    "contracts",
    "agent",
    "catalog",
    "payments",
    "frontend"
  ],
  "scripts": {
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "setup": "npm run migrate -w @cca/catalog && npm run migrate -w @cca/payments && npm run seed -w @cca/catalog",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev": "bash scripts/dev.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0"
  }
}
