# Copy to .env and fill in. Never commit .env.

# --- LLM (agent chat loop) ---
# Provider: openai | anthropic. Omit to auto-detect from whichever key is set;
# with neither key the agent uses the deterministic offline planner.
# LLM_PROVIDER=openai
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=gpt-4o          # e.g. gpt-4o, gpt-4.1, claude-sonnet-5
# Catalog search embeddings (Phase 3). Anthropic has no embeddings API.
#   hash   - default: zero-dependency, offline, deterministic lexical embedding
#            (name + brand + category + description + attributes -> 512-d)
#   voyage - real semantic embeddings; auto-selected when VOYAGE_API_KEY is set
#   openai - real semantic embeddings (text-embedding-3-small). OPT-IN ONLY:
#            set EMBEDDING_PROVIDER=openai; reuses OPENAI_API_KEY (or EMBEDDING_API_KEY)
EMBEDDING_PROVIDER=hash
# VOYAGE_API_KEY=
# EMBEDDING_API_KEY=              # dedicated key for openai embeddings (else OPENAI_API_KEY)
# EMBEDDING_MODEL=text-embedding-3-small   # or voyage-3-lite

# Merchant "paste a product list" -> structured products. Uses ANTHROPIC_API_KEY
# or OPENAI_API_KEY (whichever is set; EXTRACT_PROVIDER forces one). CSV upload
# and feed import need no key.
# EXTRACT_PROVIDER=openai
# EXTRACT_MODEL=claude-sonnet-5
# EXTRACT_MODEL_OPENAI=gpt-4.1-mini

# --- Merchant dashboard auth ---
# Signs the JWT the catalog service issues; the payments service verifies with the
# same secret. Any random string; change it for anything shared.
AUTH_SECRET=dev-insecure-secret-change-me

# --- Datastores (match docker-compose.yml) ---
DATABASE_URL=postgres://cca:cca@localhost:5432/cca
REDIS_URL=redis://localhost:6379

# --- Service URLs (local dev) ---
PAYMENTS_URL=http://localhost:4001
CATALOG_URL=http://localhost:4002
AGENT_URL=http://localhost:4003
FRONTEND_URL=http://localhost:4173

# --- Service ports ---
PAYMENTS_PORT=4001
CATALOG_PORT=4002
AGENT_PORT=4003
FRONTEND_PORT=4173

# --- Demo config ---
DEMO_MERCHANT_ID=merchant_123
