# Copy to .env and fill in. Never commit .env.

# --- LLM (agent chat loop) ---
# Provider: openai | anthropic. Omit to auto-detect from whichever key is set;
# with neither key the agent uses the deterministic offline planner.
# LLM_PROVIDER=openai
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=gpt-4o          # e.g. gpt-4o, gpt-4.1, claude-sonnet-5
# Catalog search embeddings (Phase 3). Anthropic has no embeddings API.
#   hash   - default: zero-dependency, offline, deterministic lexical embedding
#   voyage - real semantic embeddings; used automatically when VOYAGE_API_KEY is set
EMBEDDING_PROVIDER=hash
# VOYAGE_API_KEY=
# EMBEDDING_MODEL=voyage-3-lite

# --- Merchant dashboard auth ---
# Signs the JWT the catalog service issues; the payments service verifies with the
# same secret. Any random string; change it for anything shared.
AUTH_SECRET=dev-insecure-secret-change-me

# --- Datastores (match docker-compose.yml) ---
DATABASE_URL=postgres://cca:cca@localhost:5432/cca
REDIS_URL=redis://localhost:6379

# --- Service URLs (local dev) ---
PAYMENTS_URL=http://localhost:4001
CATALOG_URL=http://localhost:4002
AGENT_URL=http://localhost:4003
FRONTEND_URL=http://localhost:5173

# --- Service ports ---
PAYMENTS_PORT=4001
CATALOG_PORT=4002
AGENT_PORT=4003

# --- Demo config ---
DEMO_MERCHANT_ID=merchant_123
