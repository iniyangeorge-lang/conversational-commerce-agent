# Copy to .env and fill in. Never commit .env.

# --- LLM ---
# Anthropic API key used by the agent service (function-calling loop).
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=claude-sonnet-5
# Catalog search embeddings (Phase 3). Anthropic has no embeddings API.
#   hash   - default: zero-dependency, offline, deterministic lexical embedding
#   voyage - real semantic embeddings; used automatically when VOYAGE_API_KEY is set
EMBEDDING_PROVIDER=hash
# VOYAGE_API_KEY=
# EMBEDDING_MODEL=voyage-3-lite

# --- Datastores (match docker-compose.yml) ---
DATABASE_URL=postgres://cca:cca@localhost:5432/cca
REDIS_URL=redis://localhost:6379

# --- Service URLs (local dev) ---
PAYMENTS_URL=http://localhost:4001
CATALOG_URL=http://localhost:4002
AGENT_URL=http://localhost:4003
FRONTEND_URL=http://localhost:5173

# --- Service ports ---
PAYMENTS_PORT=4001
CATALOG_PORT=4002
AGENT_PORT=4003

# --- Demo config (merchant-configurable in Phase 2, defaults here) ---
DEFAULT_SPEND_LIMIT=150.00
STEP_UP_THRESHOLD=100.00
STEP_UP_CODE=1234
DEMO_MERCHANT_ID=merchant_123
