# Copy to .env and fill in. Never commit .env.

# --- LLM ---
# Anthropic API key used by the agent service (function-calling loop).
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=claude-sonnet-5
# Embedding model for catalog search (Phase 3). Anthropic has no embeddings API -
# default is a small local model (no key needed). Swap for a hosted one if preferred.
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
# VOYAGE_API_KEY=

# --- Datastores (match docker-compose.yml) ---
DATABASE_URL=postgres://cca:cca@localhost:5432/cca
REDIS_URL=redis://localhost:6379

# --- Service URLs (local dev) ---
PAYMENTS_URL=http://localhost:4001
CATALOG_URL=http://localhost:4002
AGENT_URL=http://localhost:4003
FRONTEND_URL=http://localhost:5173

# --- Service ports ---
PAYMENTS_PORT=4001
CATALOG_PORT=4002
AGENT_PORT=4003

# --- Demo config (merchant-configurable in Phase 2, defaults here) ---
DEFAULT_SPEND_LIMIT=150.00
STEP_UP_THRESHOLD=100.00
DEMO_MERCHANT_ID=merchant_123
